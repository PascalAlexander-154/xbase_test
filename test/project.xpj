[PROJECT]
    TARGET_DIR = .\run
    Version = 2.3
    Project.xpj

[Project.xpj]
    test.exe
    Taschenrechner.exe
    HelloWorldgui.exe
    HelloNameGUI.exe

[test.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w
    DEBUG                = yes
    GUI                  = no
    LINKER               = alink
    LINK_FLAGS           = 
    RC_COMPILE           = arc
    RC_FLAGS             = 
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
// $START-AUTODEPEND
    main.obj
// $STOP-AUTODEPEND
    main.prg

[Taschenrechner.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w
    DEBUG                = yes
    GUI                  = no
    LINKER               = alink
    LINK_FLAGS           = 
    RC_COMPILE           = arc
    RC_FLAGS             = 
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
// $START-AUTODEPEND
    main1.obj
// $STOP-AUTODEPEND
    main1.prg

[HelloWorldgui.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w 
    DEBUG                = yes
    GUI                  = yes
    LINKER               = alink
    LINK_FLAGS           = 
    RC_COMPILE           = arc
    RC_FLAGS             = 
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
// $START-AUTODEPEND
    main2.obj
// $STOP-AUTODEPEND
    main2.prg

[HelloNameGUI.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /q /w /wi /wl /wu
    DEBUG                = yes
    GUI                  = yes
    LINKER               = alink
    LINK_FLAGS           = 
    RC_COMPILE           = arc
    RC_FLAGS             = 
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
// $START-AUTODEPEND
    main3.obj
// $STOP-AUTODEPEND
    main3.prg

